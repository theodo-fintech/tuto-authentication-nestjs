JWT_SECRET='your_jwt_secret_here'
ACCESS_TOKEN_VALIDITY_DURATION_IN_SEC="3600s"
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_NAME=mydatabase
DB_PASSWORD=mypassword

# Database URL for Prisma
DATABASE_URL="postgresql://postgres:mypassword@postgres:5432/mydatabase?schema=public"

# Google OAuth Configuration
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
GOOGLE_AUTH_URL="https://accounts.google.com/o/oauth2/v2/auth"
GOOGLE_TOKEN_URL="https://www.googleapis.com/oauth2/v4/token"
GOOGLE_USER_INFO_URL="https://www.googleapis.com/oauth2/v2/userinfo"
GOOGLE_SCOPE="profile email"


# GitHub OAuth Configuration
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"
GITHUB_CALLBACK_URL="http://localhost:3000/oauth/github/callback"
GITHUB_AUTH_URL="https://github.com/login/oauth/authorize"
GITHUB_TOKEN_URL="https://github.com/login/oauth/access_token"
GITHUB_USER_INFO_URL="https://api.github.com/user"
GITHUB_USER_EMAIL_URL="https://api.github.com/user/emails"
GITHUB_SCOPE="user:email"

# Microsoft OAuth Configuration
MICROSOFT_CLIENT_ID="your_microsoft_client_id"
MICROSOFT_CLIENT_SECRET="your_microsoft_client_secret"
MICROSOFT_CALLBACK_URL="http://localhost:3000/oauth/microsoft/callback"
MICROSOFT_AUTH_URL="https://login.microsoftonline.com/common/oauth2/v2.0/authorize"
MICROSOFT_TOKEN_URL="https://login.microsoftonline.com/common/oauth2/v2.0/token"
MICROSOFT_USER_INFO_URL="https://graph.microsoft.com/v1.0/me"
MICROSOFT_SCOPE="openid profile email"